{
  "name": "blanks",
  "version": "0.2.5",
  "description": "Blanks - An enhanced markdown editor based on MarkText",
  "author": "Galileo Lion",
  "homepage": "https://github.com/GalileoLion/Blanks",
  "repository": {
    "type": "git",
    "url": "https://github.com/GalileoLion/Blanks.git"
  },
  "bugs": {
    "url": "https://github.com/GalileoLion/Blanks/issues"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "editor",
    "tauri",
    "vue3",
    "wysiwyg",
    "marktext"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "node scripts/minify-locales.mjs",
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "npm run minify-locales && tauri build",
    "dev:tauri:web": "vite --config vite.tauri.config.js",
    "build:tauri:web": "vite build --config vite.tauri.config.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run minify-locales && tauri build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@marktext/file-icons": "^1.0.6",
    "@octokit/rest": "^22.0.1",
    "@popperjs/core": "^2.11.8",
    "@vscode/ripgrep": "^1.17.0",
    "arg": "^5.0.2",
    "axios": "^1.13.2",
    "codemirror": "^5.65.19",
    "deep-equal": "^2.2.3",
    "dom-autoscroller": "^2.3.4",
    "dompurify": "^3.3.1",
    "dragula": "^3.7.3",
    "element-plus": "^2.13.0",
    "element-resize-detector": "^1.2.4",
    "execall": "^3.0.0",
    "flowchart.js": "^1.18.0",
    "fuzzaldrin": "^2.1.0",
    "github-markdown-css": "^5.8.1",
    "html-tags": "^5.1.0",
    "iso-639-1": "^3.1.5",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "katex": "^0.16.27",
    "languine": "^3.1.4",
    "mermaid": "^11.12.2",
    "mitt": "^3.0.1",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "snabbdom": "^3.6.3",
    "snabbdom-to-html": "^7.1.0",
    "snapsvg-cjs": "^0.0.6",
    "turndown": "^7.2.2",
    "underscore": "^1.13.7",
    "vega-embed": "^7.1.0",
    "vite-plugin-prismjs": "^0.0.11",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4",
    "webfontloader": "^1.6.28"
