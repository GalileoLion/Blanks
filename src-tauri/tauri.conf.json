{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blanks",
  "version": "0.2.5",
  "identifier": "com.blanks.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:tauri:web",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blanks",
        "width": 1100,
        "height": 760,
        "minWidth": 550,
        "minHeight": 350,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data: file: asset:; font-src 'self' data:; connect-src * ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icons/icon.png",
      "../build/icons/icon.icns",
      "../build/icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "../build/mac/entitlements.mac.plist"
    }
  }
}
